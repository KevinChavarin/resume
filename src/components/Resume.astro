---
import SocialLinks from "./SocialLinks.astro";
import AboutMe from "./AboutMe.astro";
import Experience from "./Experience.astro";
import Certifications from "./Certifications.astro";
import ThemeSwitcher from "./ThemeSwitcher.tsx";
import LanguageSwitcher from "./LanguageSwitcher.tsx";
import Translate from "./Translate.tsx";
import Skills from "./Skills.astro";
import ProjectsCarousel from "./ProjectsCarousel.tsx";

type Project = {
  title: string;
  description: string;
  link?: string;
  technologies: string[];
  github?: string;
};

const projects: Project[] = [
  {
    title: "projects.project1.title",
    description: "projects.project1.description",
    link: "/choizfood/",
    technologies: [
      "Flutter",
      "Supabase",
    ],
  },
  {
    title: "projects.project2.title",
    description: "projects.project2.description",
    link: "https://facebook.com",
    technologies: [
      "React",
      "TypeScript",
      "Tailwind CSS",
      "Storybook",
      "SEO Optimized",
    ],
    github: "https://github.com/KevinChavarin/personal-blog",
  },
  {
    title: "projects.project3.title",
    description: "projects.project3.description",
    technologies: ["HTML", "CSS", "Javascript", "PHP", "MySQL"],
    github: "https://github.com/KevinChavarin/proyecto-asesoria",
  },
  {
    title: "projects.project4.title",
    description: "projects.project4.description",
    technologies: ["React", "ExpressJS", "Carbon Design System", "SASS"],
  },
];
---
<main
  class="min-h-screen bg-white/50 dark:bg-neutral-950/50 flex flex-col items-center justify-start px-4 py-16 sm:py-20"
>
  <header class="flex items-start justify-between w-full max-w-4xl mb-6 pt-8 sm:pt-12">
    <div>
      <h1 class="text-3xl md:text-6xl font-bold text-neutral-900 dark:text-white mb-2 tracking-tight">
        Kevin Chavarin
      </h1>
      <div class="max-w-4xl w-full mb-2">
        <p class="text-neutral-500 dark:text-neutral-300 text-base">
          <Translate textKey="role" fallback="Role" client:load />
        </p>
      </div>
      <SocialLinks />
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <ThemeSwitcher client:load/>
      <LanguageSwitcher client:load />
    </div>
  </header>

  <section class="mb-8 sm:mb-12">
    <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
      <Translate
        textKey="aboutMe"
        fallback="About Me"
        client:load>
    </h2>
    <AboutMe />
  </section>
  <section class="mb-8 sm:mb-12">
    <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
      <Translate
        textKey="experience"
        fallback="Experience"
        client:load>
    </h2>
    <Experience />
  </section>
  <section class="max-w-4xl w-full mb-8 sm:mb-12">
    <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
      <Translate
        textKey="education.label"
        fallback="education.label"
        client:load>
    </h2>
    <div class="space-y-4">
      <div class="flex items-center">
        <h3 class="text-xl font-semibold text-neutral-900 dark:text-white">
          <Translate
            textKey="education.degree"
            fallback="Bachelor's degree in Information Technologies"
            client:load
          />
        </h3>
        <h3 class="text-neutral-500 dark:text-neutral-300 text-base ml-auto">
          <Translate
            textKey="education.duration"
            fallback="January 2020 - June 2025"
            client:load
          />
        </h3>
      </div>
      <p class="text-neutral-500 dark:text-neutral-300 text-base">
        <Translate
          textKey="education.institution"
          fallback="University of Guadalajara"
          client:load
        />
      </p>
      <div>
        <span class="inline-block px-2 py-1 text-sm rounded bg-white/50 dark:bg-white/10 backdrop-blur-sm text-gray-800 dark:text-neutral-200 border border-white/30 dark:border-white/10 hover:bg-white/70 dark:hover:bg-white/20 transition-colors mt-1">
          <Translate
            textKey="education.specialization"
            fallback="Cybersecurity specialization"
            client:load
          />
        </span>
      </div>
    </div>
  </section>

  <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
    <Translate
      textKey="projects.label"
      fallback="Projects"
      client:load
    />
  </h2>
  <ProjectsCarousel projects={projects} client:load />
  <section class="max-w-4xl w-full mb-8 sm:mb-12">
    <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
      <Translate
        textKey="skills"
        fallback="Skills"
        client:load
      />
    </h2>
    <Skills />
  </section>
  <section class="max-w-4xl w-full mb-8 sm:mb-12">
    <h2 class="text-3xl font-bold text-neutral-900 dark:text-white mb-6">
      <Translate
        textKey="certifications"
        fallback="Certifications"
        client:load>
    </h2>
    <Certifications />
  </section>

</main>
